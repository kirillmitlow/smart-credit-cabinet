meta {
  name: Предпросмотр ООО без сохранения
  type: http
  seq: 1
}

post {
  url: {{scenariosUrl}}/api/v1/scenarios/preview
  body: json
  auth: none
}

headers {
  X-Admin-Key: {{mockAdminKey}}
  Content-Type: application/json
}

body:json {
  {
    "code": "jury-preview",
