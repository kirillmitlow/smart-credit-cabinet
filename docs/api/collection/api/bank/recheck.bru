meta {
  name: Перепроверить заявку после восстановления источника
  type: http
  seq: 4
}

post {
  url: {{apiUrl}}/backoffice/applications/{{applicationId}}/recheck
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{recheckActionKey}}
}

body:json {
  {"expectedVersion": {{applicationVersion}}}
}
