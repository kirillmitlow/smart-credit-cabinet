  "components": {
    "schemas": {
      "ActiveCompany": {
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid",
            "title": "Companyid"
          }
        },
        "type": "object",
        "required": [
          "companyId"
        ],
        "title": "ActiveCompany"
      },
      "ApplicationFields": {
        "properties": {
          "productCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(EXPRESS|WORKING_CAPITAL|CONTRACT|CREDIT_LINE|OVERDRAFT|INVESTMENT)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Productcode"
          },
          "amountRub": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amountrub"
          },
          "termMonths": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Termmonths"
          },
          "purposeCode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Purposecode"
          }
        },
        "type": "object",
        "title": "ApplicationFields"
      },
      "ApplicationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "number": {
            "type": "string",
            "title": "Number"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "productCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Productcode"
          },
          "amountRub": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amountrub"
          },
          "termMonths": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Termmonths"
          },
          "purposeCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purposecode"
          },
          "draft": {
            "additionalProperties": true,
            "type": "object",
            "title": "Draft"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "submittedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submittedat"
          },
          "allowedActions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowedactions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "status",
          "productCode",
          "amountRub",
          "termMonths",
          "purposeCode",
          "draft",
          "version",
          "createdAt",
          "submittedAt",
          "allowedActions"
        ],
        "title": "ApplicationOut",
        "description": "Клиентская модель: без баллов, DSCR и снимков источников."
      },
      "ApplicationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApplicationOut"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "ApplicationPage"
      },
      "CodeCheck": {
        "properties": {
          "requestId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Requestid"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "code"
        ],
        "title": "CodeCheck"
      },
      "CodeIssued": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "expiresInSeconds": {
            "type": "integer",
            "title": "Expiresinseconds"
          },
          "demoCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Democode",
            "description": "Только в демо-режиме: код вместо SMS"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "expiresInSeconds"
        ],
        "title": "CodeIssued"
      },
      "CodeRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "companyId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Companyid"
          }
        },
        "type": "object",
        "required": [
          "userId"
        ],
        "title": "CodeRequest"
      },
      "CompanyBrief": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "canApply": {
            "type": "boolean",
            "title": "Canapply"
          }
        },
        "type": "object",
        "required": [
          "id",
          "inn",
          "name",
          "status",
          "canApply"
        ],
        "title": "CompanyBrief"
      },
      "CompanyChoice": {
        "properties": {
          "company": {
            "$ref": "#/components/schemas/CompanyBrief"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "company",
          "role"
        ],
        "title": "CompanyChoice"
      },
      "DraftPatch": {
        "properties": {
          "productCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(EXPRESS|WORKING_CAPITAL|CONTRACT|CREDIT_LINE|OVERDRAFT|INVESTMENT)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Productcode"
          },
          "amountRub": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amountrub"
          },
          "termMonths": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Termmonths"
          },
          "purposeCode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Purposecode"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers",
            "description": "Ответы мастера и анкеты по шагам"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "DraftPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeResponse": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "displayName": {
            "type": "string",
            "title": "Displayname"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "activeCompanyId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activecompanyid"
          },
          "companies": {
            "items": {
              "$ref": "#/components/schemas/CompanyChoice"
            },
            "type": "array",
            "title": "Companies"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "displayName",
          "role",
          "activeCompanyId",
          "companies"
        ],
        "title": "MeResponse"
      },
