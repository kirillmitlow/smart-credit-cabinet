        }
      }
    },
    "/applications/{application_id}/withdraw": {
      "post": {
        "tags": [
          "заявки"
        ],
        "summary": "Отозвать заявку",
        "operationId": "withdrawApplication",
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
