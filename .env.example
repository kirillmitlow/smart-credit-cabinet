# Настройки стенда (50-13). Для локального запуска файл НЕ нужен: все значения ниже уже заданы
# по умолчанию в docker-compose.yml. Скопируйте в .env (`cp .env.example .env`), только если хотите что-то поменять.
#
# ВСЕ секреты ниже — значения ТОЛЬКО ДЛЯ РАЗРАБОТКИ. Не используйте их на облачном стенде:
# там (docker-compose.cloud.yml) каждый секрет обязателен и значения по умолчанию нет.
# Сгенерировать свой секрет: openssl rand -hex 24

# --- Общие ---

# «Сегодня» для всего стенда, ГГГГ-ММ-ДД. Пусто = реальная дата. Сменили — перезапустите стенд.
APP_TODAY=

# Порт интерфейса на вашем ПК (адрес http://127.0.0.1:<порт>). Поменяйте, если 8080 занят другой программой.
WEB_PORT=8080

# Тег образов (локально образы собираются из исходников, тег нужен только для публикации в GHCR)
IMAGE_TAG=dev

# --- Хранилища (секреты) ---

# Пароль суперпользователя Postgres и владельца базы api. Только для разработки.
POSTGRES_PASSWORD=dev-postgres

# Пароль пользователей баз моков (mock_registry, mock_tax, …). Только для разработки.
MOCK_DB_PASSWORD=dev-mock-db

# --- Внешние системы (моки, раздел 3.4 спецификации моков) ---

# Ключи, с которыми api ходит в бизнес-API моков (заголовок X-Api-Key). Только для разработки.
REGISTRY_API_KEY=dev-registry-key
TAX_API_KEY=dev-tax-key
BKI_API_KEY=dev-bki-key
BANK_CORE_API_KEY=dev-bank-core-key

# Админ-ключ: /admin/* всех моков и весь mock-scenarios (заголовок X-Admin-Key). Только для разработки.
MOCK_ADMIN_KEY=dev-admin-key
